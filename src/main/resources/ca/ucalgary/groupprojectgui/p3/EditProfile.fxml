<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.EditProfileController"
           prefWidth="1200" prefHeight="800"
           stylesheets="@styles/edit_profile.css"
           styleClass="root">

    <!-- Centered form -->
    <VBox spacing="20" alignment="CENTER">
        <Label text="Edit Profile" styleClass="section-title"/>

        <TextField fx:id="usernameField" promptText="Username" styleClass="form-field"/>
        <TextField fx:id="emailField" promptText="Email" styleClass="form-field"/>

        <Button text="Save Changes"

                styleClass="save-button"
                prefWidth="200" prefHeight="45"/>
    </VBox>

    <!-- Bottom back button -->
    <AnchorPane pickOnBounds="false">
        <Button text="← Back"
                onAction="#handleBack"
                styleClass="neon-outline-button"
                prefWidth="120" prefHeight="40"
                AnchorPane.leftAnchor="30.0"
                AnchorPane.bottomAnchor="30.0"/>
    </AnchorPane>

</StackPane>
