<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.NotificationPanelController"
           alignment="TOP_RIGHT"
           styleClass="blur-overlay"
           stylesheets="@styles/friend_popup.css">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox fx:id="notificationPanel"
          spacing="15"
          alignment="TOP_CENTER"
          maxWidth="400"
          styleClass="neon-border-panel"
          style="-fx-padding: 20;
                 -fx-background-radius: 20;
                 -fx-background-color: #0d0d0d;
                 -fx-effect: dropshadow(gaussian, #ff00ff, 40, 0.5, 0, 0);
                 -fx-border-color: #ff00ff;
                 -fx-border-width: 2;
                 -fx-border-radius: 20;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT">
            <Label text="🔔 NOTIFICATIONS" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeButton"
                    text="✖"
                    onAction="#closePanel"
                    styleClass="close-button"/>
        </HBox>

        <!-- Notification List -->
        <ListView fx:id="notificationList"
                  prefHeight="200"
                  style="-fx-background-color: transparent;
                 -fx-control-inner-background: transparent;
                 -fx-border-color: transparent;
                 -fx-text-fill: white;"
        />


    </VBox>
</StackPane>
