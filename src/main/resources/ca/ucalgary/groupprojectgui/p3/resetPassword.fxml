<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.ResetPasswordController"
            prefWidth="600" prefHeight="500"
            style="-fx-background-color: linear-gradient(to bottom, #1c1f2b, #2a2d3e);">

    <!-- Main Center Content -->
    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="40" left="40" right="40" bottom="20"/>
            </padding>

            <Label text="Reset Your Password" style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: bold;" />

            <!-- Email Input -->
            <TextField fx:id="emailField" promptText="Enter your email" />

            <!-- Send Token Button -->
            <Button text="Send Reset Token" onAction="#handleSendToken" />

            <!-- Token Input -->
            <TextField fx:id="oldPassword" promptText="Enter reset token" />

            <!-- New Password Input -->
            <PasswordField fx:id="newPasswordField" promptText="Enter new password" />

            <!-- Reset Button -->
            <Button text="Reset Password" onAction="#handleResetPassword" />

            <!-- Status Message -->
            <Label fx:id="statusLabel" wrapText="true" style="-fx-text-fill: #ff4444;" />
        </VBox>
    </center>

    <!-- Bottom: Back Button -->
    <bottom>
        <HBox alignment="CENTER" spacing="10">
            <padding>
                <Insets top="10" bottom="10" left="20" right="20"/>
            </padding>
            <Button text="⬅ Back" onAction="#handleBack"/>
        </HBox>
    </bottom>


</BorderPane>
