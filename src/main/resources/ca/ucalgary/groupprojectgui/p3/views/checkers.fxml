<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           maxWidth="-1" maxHeight="-1"
           fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.CheckersController"
           stylesheets="@../styles/checkers.css"

>

    <children>
        <!-- BACKGROUND LAYERS -->
        <Region fx:id="backgroundLayer" maxWidth="-1" maxHeight="-1"/>
        <Region fx:id="glowLayer" maxWidth="-1" maxHeight="-1" mouseTransparent="true"/>
        <Region fx:id="scanlinesLayer" maxWidth="-1" maxHeight="-1" mouseTransparent="true"/>

        <!-- MAIN CONTAINER: Using a BorderPane as mainGamePane -->
        <BorderPane fx:id="mainGamePane" maxWidth="-1" maxHeight="-1">
            <center>
                <HBox fx:id="container" alignment="CENTER" spacing="10" maxWidth="-1" maxHeight="-1">
                    <children>
                        <!-- GAME AREA -->
                        <VBox fx:id="gameArea" alignment="TOP_CENTER" spacing="15" HBox.hgrow="ALWAYS" maxWidth="-1" maxHeight="-1">
                            <children>
                                <!-- Game Title -->
                                <Label fx:id="gameTitle" text="GAME NAME"/>
                                <!-- Player Info -->
                                <HBox fx:id="playerInfo" alignment="CENTER" spacing="30" HBox.hgrow="ALWAYS">
                                    <children>
                                        <!-- Renamed to match controller -->
                                        <HBox fx:id="player1Container" alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label fx:id="avatar1" text="P1"/>
                                                <Label fx:id="player1Name" styleClass="player-name" text="ALLIGATOR"/>
                                                <StackPane fx:id="checkerPiece1">
                                                    <Circle fx:id="checkerCircle1" radius="20" styleClass="checker-black"/>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                        <Label fx:id="vsBadge" text="VS"/>
                                        <HBox fx:id="player2Container" alignment="CENTER" spacing="40" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label fx:id="avatar2" text="P2"/>
                                                <Label fx:id="player2Name" styleClass="player-name" text="CHAMELEON" />
                                                <StackPane fx:id="checkerPiece2">
                                                    <Circle fx:id="checkerCircle2" radius="20" styleClass="checker-white"/>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER" spacing="20">
                                    <children>
                                        <Label fx:id="timeElapsed" text="TIME: 00:00" styleClass="time-label"/>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Circle fx:id="turnPiece" radius="25" styleClass="checker-black"/>
                                        <Label fx:id="turnLabel" styleClass="moves-label" text="Black's TURN"/>
                                    </children>
                                </HBox>
                                <!-- Board Container -->
                                <StackPane fx:id="boardContainer" style="-fx-alignment: center;" VBox.vgrow="ALWAYS"/>
                                <!-- Game Controls -->
                                <HBox fx:id="gameControls" alignment="CENTER" spacing="20">
                                    <Button fx:id="leaveGame" text="Leave Game"/>
                                </HBox>
                            </children>
                        </VBox>



                        <!-- CHAT SIDEBAR -->
                        <VBox fx:id="chatSidebar" spacing="15" minWidth="250" prefWidth="350" maxWidth="400"
                              maxHeight="-1">
                            <!-- Chat Header -->
                            <Label fx:id="chatHeader" text="NEON NETWORK"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold;" alignment="CENTER"
                                   maxWidth="Infinity">
                                <padding>
                                    <Insets bottom="10"/>
                                </padding>
                            </Label>
                            <!-- Chat Messages inside a ScrollPane -->
                            <ScrollPane fx:id="chatScrollPane" VBox.vgrow="ALWAYS" fitToWidth="true"
                                        prefHeight="300"
                                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                                <VBox fx:id="chatMessages" spacing="8" style="chat-message"/>
                            </ScrollPane>
                            <!-- Chat Input Area -->
                            <HBox fx:id="chatInputArea" alignment="CENTER" spacing="10">
                                <TextField fx:id="chatInput" HBox.hgrow="ALWAYS" promptText="Type message..."/>
                                <Button fx:id="sendBtn" onAction="#onSendMessage" text="SEND" />
                            </HBox>
                        </VBox>
                    </children>
                </HBox>
            </center>
        </BorderPane>

        <!-- CORNER ACCENTS -->
        <Pane fx:id="cornersPane" maxWidth="-1" maxHeight="-1" mouseTransparent="true">
            <children>
                <Region fx:id="topLeft"/>
                <Region fx:id="topRight"/>
                <Region fx:id="bottomLeft"/>
                <Region fx:id="bottomRight"/>
            </children>
        </Pane>
    </children>
</StackPane>