<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Pos?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.LogoutPanelController"
           fx:id="logoutPanel"
           alignment="CENTER"
           maxWidth="400"
           styleClass="overlay-panel">

    <VBox spacing="25"
          alignment="CENTER"
          styleClass="neon-dialog-box"
          prefWidth="350"
          prefHeight="200">

        <Label text="Are you sure you want to log out?"
               wrapText="true"
               alignment="CENTER"
               styleClass="section-title" />

        <HBox spacing="20" alignment="CENTER">
            <Button fx:id="confirmLogoutButton"
                    text="Yes"
                    onAction="#confirmLogout"
                    styleClass="danger-outline-button"
                    prefWidth="100" prefHeight="40"/>

            <Button fx:id="cancelLogoutButton"
                    text="Cancel"
                    onAction="#cancelLogout"
                    styleClass="neon-outline-button"
                    prefWidth="100" prefHeight="40"/>
        </HBox>

    </VBox>
</StackPane>
