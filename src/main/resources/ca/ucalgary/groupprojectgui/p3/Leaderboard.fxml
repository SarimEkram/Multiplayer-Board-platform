<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="800" prefWidth="1200" styleClass="root" stylesheets="@styles/leaderboard.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.LeaderboardController">

    <VBox alignment="TOP_CENTER" prefHeight="700" prefWidth="1000" spacing="30" styleClass="leaderboard-card">

        <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="71.0" prefWidth="1118.0" styleClass="section-title" text="Leaderboard" />

        <fx:define>
            <ToggleGroup fx:id="gameToggleGroup" />
        </fx:define>

        <HBox alignment="CENTER" spacing="10">
            <ToggleButton fx:id="ticTacToeToggle" text="Tic Tac Toe" toggleGroup="$gameToggleGroup" />
            <ToggleButton fx:id="checkersToggle" text="Checkers" toggleGroup="$gameToggleGroup" />
            <ToggleButton fx:id="connect4Toggle" text="Connect 4" toggleGroup="$gameToggleGroup" />
        </HBox>
        <!-- Leaderboard VBoxes (only one shown at a time) -->
        <VBox fx:id="leaderboardContainer" spacing="10">
            <!-- Header stays fixed -->
            <HBox fx:id="leaderboardHeader" alignment="CENTER" spacing="20" styleClass="leaderboard-data-header">
                <Label alignment="CENTER" minWidth="40" text="Rank" />
                <Label alignment="CENTER" minWidth="120" text="User ID" />
                <Label alignment="CENTER" minWidth="180" text="Username" />
                <Label alignment="CENTER" minWidth="100" text="Level" />
                <Label alignment="CENTER" minWidth="120" text="MMR" />
                <Label alignment="CENTER" minWidth="150" text="Rank Tier" />
            </HBox>
        </VBox>

        <StackPane>
            <ScrollPane fx:id="ticTacToeScroll" fitToHeight="true" fitToWidth="true" visible="true">
                <VBox fx:id="ticTacToeLeaderboard" alignment="TOP_CENTER" spacing="10" />
            </ScrollPane>
            <ScrollPane fx:id="checkersScroll" fitToHeight="true" fitToWidth="true" visible="false">
                <VBox fx:id="checkersLeaderboard" alignment="TOP_CENTER" spacing="10" />
            </ScrollPane>
            <ScrollPane fx:id="connect4Scroll" fitToHeight="true" fitToWidth="true" visible="false">
                <VBox fx:id="connect4Leaderboard" alignment="TOP_CENTER" spacing="10" />
            </ScrollPane>
        </StackPane>

        <!-- Back Button -->
        <Button onAction="#handleBack" prefHeight="40" prefWidth="120" styleClass="neon-outline-button" text="← Back" />
    </VBox>
</StackPane>
