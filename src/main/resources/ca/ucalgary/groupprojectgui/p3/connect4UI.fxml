<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           maxWidth="-1" maxHeight="-1"
            fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.Connect4Controller">

    <children>

        <!-- BACKGROUND LAYERS -->
        <Region fx:id="backgroundLayer"
                maxWidth="-1" maxHeight="-1"/>
        <Region fx:id="glowLayer"
                maxWidth="-1" maxHeight="-1"/>
        <Region fx:id="scanlinesLayer"
                maxWidth="-1" maxHeight="-1"/>

        <!-- MAIN CONTAINER: GAME AREA (LEFT) AND CHAT SIDEBAR (RIGHT) -->
        <HBox fx:id="container"
              alignment="CENTER"
              spacing="10"
              maxWidth="-1" maxHeight="-1">
            <children>

                <!-- GAME AREA - Takes most of the space -->
                <VBox fx:id="gameArea"
                      alignment="TOP_CENTER"
                      spacing="15"
                      HBox.hgrow="ALWAYS"
                      maxWidth="-1" maxHeight="-1">
                    <children>

                        <!-- Game Title -->
                        <Label fx:id="gameTitle" text="Neon Connect 4"/>

                        <!-- Player Info -->
                        <HBox fx:id="playerInfo"
                              alignment="CENTER"
                              spacing="30"
                              HBox.hgrow="ALWAYS">
                            <children>
                                <VBox fx:id="player1" alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-alignment: center-left;">
                                    <!-- content -->
                                    <children>
                                        <Label fx:id="avatar1" text="P1"/>
                                        <Label fx:id="name1" text="Neon"/>
                                        <Label fx:id="score1" text="SCORE: 0"/>
                                    </children>
                                </VBox>

                                <Label fx:id="vsBadge" text="VS"/>

                                <VBox fx:id="player2" alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-alignment: center-right;">
                                    <!-- content -->
                                    <children>
                                        <Label fx:id="avatar2" text="P2"/>
                                        <Label fx:id="name2" text="Cyber"/>
                                        <Label fx:id="score2" text="SCORE: 0"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <!-- Board Container (Expands to fill vertical space) -->
                        <StackPane fx:id="boardContainer"
                                   style="-fx-alignment: center;"
                                   VBox.vgrow="ALWAYS">
                            <children>
                                <GridPane fx:id="board"
                                          alignment="CENTER"
                                          hgap="10" vgap="10">
                                    <padding>
                                        <Insets top="25" right="25" bottom="25" left="25"/>
                                    </padding>
                                    <!-- Board cells can be added programmatically -->
                                </GridPane>
                            </children>
                        </StackPane>

                        <!-- Game Controls -->
                        <HBox fx:id="gameControls"
                              alignment="CENTER"
                              spacing="20">
                            <children>
                                <Button fx:id="newGameBtn" text="New Game"/>
                                <Button fx:id="resetBtn" text="Reset"/>
                                <Button fx:id="soundBtn" text="Sound: On"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- CHAT SIDEBAR - Fixed width sidebar -->

                <!-- CHAT SIDEBAR - Responsive width sidebar -->
                <VBox fx:id="chatSidebar"
                      spacing="15"
                      minWidth="250"
                      prefWidth="350"
                      maxWidth="400"
                      maxHeight="-1">
                    <children>

                        <!-- Chat Header -->
                        <Label fx:id="chatHeader" text="NEON NETWORK">
                            <padding>
                                <Insets bottom="10"/>
                            </padding>
                        </Label>

                        <!-- Chat Messages (Expands to fill available space) -->
                        <VBox fx:id="chatMessages"
                              VBox.vgrow="ALWAYS"
                              spacing="8"
                              style="-fx-background-color: rgba(0, 0, 0, 0.3); -fx-padding: 15; -fx-font-size: 16px; -fx-border-radius: 5; -fx-border-color: rgba(255, 0, 255, 0.2); -fx-background-radius: 5; -fx-effect: innershadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0, 0, 0);"/>

                        <!-- Chat Input Area (fixed height at bottom) -->
                        <HBox fx:id="chatInputArea"
                              alignment="CENTER"
                              spacing="10">
                            <children>
                                <TextField fx:id="chatInput"
                                           HBox.hgrow="ALWAYS"
                                           promptText="Type message..."/>
                                <Button fx:id="sendBtn" text="SEND"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>


            </children>
        </HBox>

        <!-- CORNER ACCENTS -->
        <Pane fx:id="cornersPane"
              maxWidth="-1" maxHeight="-1">
            <children>
                <Region fx:id="topLeft"/>
                <Region fx:id="topRight"/>
                <Region fx:id="bottomLeft"/>
                <Region fx:id="bottomRight"/>
            </children>
        </Pane>
    </children>
</StackPane>