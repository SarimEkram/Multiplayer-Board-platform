<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="p" prefHeight="800" prefWidth="1200" styleClass="main-background" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.Connect4Controller">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>

            <Circle fill="#FFC107" radius="25" />

            <Label styleClass="turn-label" text="YOUR TURN" />
            <Label styleClass="timer-label" text="(23s)" />

            <HBox HBox.hgrow="ALWAYS" />

            <Button styleClass="play-button" text="Play Again" />
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox alignment="CENTER" prefWidth="200" spacing="20" styleClass="sidebar">
            <padding><Insets bottom="20" left="20" right="20" top="30" /></padding>

            <VBox alignment="CENTER" spacing="8">
                <Circle fill="#ff00cc" radius="40" styleClass="circle" />
                <Label styleClass="player-label" text="Royal Hiepoulas" />
                <Label styleClass="score-label" text="Score: 0" />
            </VBox>

            <Label styleClass="vs-label" text="VS" />

            <VBox alignment="CENTER" spacing="8">
                <Circle fill="#00ffff" radius="40" styleClass="circle" />
                <Label styleClass="player-label" text="NICE!!! Mockingbird" />
                <Label styleClass="score-label" text="Score: 0" />
            </VBox>
        </VBox>
    </left>

    <!-- CENTER: BOARD -->
    <center>
        <StackPane fx:id="boardContainer" alignment="CENTER" styleClass="board-container">
            <!-- Board will be built dynamically -->
        </StackPane>
    </center>

    <!-- RIGHT SIDEBAR: CHAT -->
    <right>
        <VBox alignment="TOP_CENTER" prefWidth="280" spacing="15" styleClass="sidebar">
            <padding><Insets bottom="20" left="20" right="20" top="30" /></padding>

            <Label styleClass="chat-label" text="CHAT" />

            <TextArea fx:id="chatArea"  editable="false" prefHeight="638.0" prefRowCount="15" prefWidth="240.0" styleClass="text-area" />

            <HBox spacing="5">
                <TextField fx:id="chatInput" promptText="Type a message..." styleClass="text-field" />
                <Button onAction="#onSendMessage" styleClass="send-button" text="Send" />
            </HBox>
        </VBox>
    </right>

</BorderPane>
