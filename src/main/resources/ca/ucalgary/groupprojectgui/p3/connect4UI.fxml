<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           maxWidth="-1" maxHeight="-1"
           fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.Connect4Controller">

    <children>
        <!-- BACKGROUND LAYERS -->
        <Region fx:id="backgroundLayer" maxWidth="-1" maxHeight="-1"/>
        <Region fx:id="glowLayer" maxWidth="-1" maxHeight="-1" mouseTransparent="true"/>
        <Region fx:id="scanlinesLayer" maxWidth="-1" maxHeight="-1" mouseTransparent="true"/>

        <!-- MAIN CONTAINER: Using a BorderPane as mainGamePane -->
        <BorderPane fx:id="mainGamePane" maxWidth="-1" maxHeight="-1">
            <center>
                <HBox fx:id="container" alignment="CENTER" spacing="10" maxWidth="-1" maxHeight="-1">
                    <children>
                        <!-- GAME AREA -->
                        <VBox fx:id="gameArea" alignment="TOP_CENTER" spacing="15" HBox.hgrow="ALWAYS" maxWidth="-1" maxHeight="-1">
                            <children>
                                <!-- Game Title -->
                                <Label fx:id="gameTitle" text="OMG Connect 4"/>
                                <!-- Player Info -->
                                <HBox fx:id="playerInfo" alignment="CENTER" spacing="30" HBox.hgrow="ALWAYS">
                                    <children>
                                        <!-- Renamed to match controller -->
                                        <HBox fx:id="player1DiscContainer" alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-alignment: center-left;">
                                            <children>
                                                <Label fx:id="avatar1" text="P1"/>
                                                <Label fx:id="name1" text="Neon"/>
                                                <Label fx:id="score1" text="SCORE: 0"/>
                                            </children>
                                        </HBox>
                                        <Label fx:id="vsBadge" text="VS"/>
                                        <HBox fx:id="player2DiscContainer" alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-alignment: center-right;">
                                            <children>
                                                <Label fx:id="avatar2" text="P2"/>
                                                <Label fx:id="name2" text="Cyber"/>
                                                <Label fx:id="score2" text="SCORE: 0"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>
                                <!-- Board Container -->
                                <StackPane fx:id="boardContainer" style="-fx-alignment: center;" VBox.vgrow="ALWAYS">
                                    <children>
                                        <!-- Connect 4 Board Grid -->
                                        <GridPane fx:id="connect4Grid" hgap="5" vgap="5" alignment="CENTER">
                                            <padding>
                                                <Insets top="25" right="25" bottom="25" left="25"/>
                                            </padding>
                                        </GridPane>
                                        <!-- Column selection indicators -->
                                        <HBox fx:id="columnSelectors" alignment="CENTER" spacing="5" mouseTransparent="true">
                                            <padding>
                                                <Insets bottom="10"/>
                                            </padding>
                                        </HBox>
                                    </children>
                                </StackPane>
                                <!-- Game Controls -->
                                <HBox fx:id="gameControls" alignment="CENTER" spacing="20">
                                    <children>
                                        <Button fx:id="leaveGameBtn" text="Leave Game"/> <!-- New Leave Game button -->
                                    </children>
                                </HBox>
                            </children>
                        </VBox>



                        <!-- CHAT SIDEBAR -->
                        <VBox fx:id="chatSidebar" spacing="15" minWidth="250" prefWidth="350" maxWidth="400" maxHeight="-1">
                            <children>
                                <!-- Chat Header -->
                                <Label fx:id="chatHeader" text="NEON NETWORK" style="-fx-font-size: 18px; -fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity">
                                    <padding>
                                        <Insets bottom="10"/>
                                    </padding>
                                </Label>
                                <!-- Chat Messages inside a ScrollPane -->
                                <ScrollPane fx:id="chatScrollPane" VBox.vgrow="ALWAYS" fitToWidth="true" prefHeight="300"
                                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                                    <content>
                                        <VBox fx:id="chatMessages" spacing="8"
                                              style="-fx-background-color: rgba(0, 0, 0, 0.3); -fx-padding: 15; -fx-font-size: 16px; -fx-border-radius: 5; -fx-border-color: rgba(255, 0, 255, 0.2); -fx-background-radius: 5; -fx-effect: innershadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0, 0, 0);"/>
                                    </content>
                                </ScrollPane>
                                <!-- Chat Input Area -->
                                <HBox fx:id="chatInputArea" alignment="CENTER" spacing="10">
                                    <children>
                                        <TextField fx:id="chatInput" HBox.hgrow="ALWAYS" promptText="Type message..." onAction="#onSendMessage"/>
                                        <Button fx:id="sendBtn" text="SEND" onAction="#onSendMessage" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </center>
        </BorderPane>

        <!-- CORNER ACCENTS -->
        <Pane fx:id="cornersPane" maxWidth="-1" maxHeight="-1" mouseTransparent="true">
            <children>
                <Region fx:id="topLeft"/>
                <Region fx:id="topRight"/>
                <Region fx:id="bottomLeft"/>
                <Region fx:id="bottomRight"/>
            </children>
        </Pane>
    </children>
</StackPane>



