<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="homePane"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.HomePageController"
            styleClass="home-background"

            prefWidth="1200" prefHeight="800">


    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="🎮 OMG" styleClass="logo-label"/>
            <Region fx:id="spacer" HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" text="Welcome, Player!" styleClass="welcome-label"/>
            <Button text="Logout" fx:id="logoutButton" styleClass="logout-button"/>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR: Friends -->
    <left>
        <VBox spacing="10" prefWidth="250" styleClass="sidebar-left">
            <padding>
                <Insets top="20" left="15" right="15" bottom="20"/>
            </padding>
            <Label text="Friends Online" styleClass="sidebar-title"/>
            <ListView fx:id="friendsList" styleClass="list-view"/>
        </VBox>
    </left>

    <!-- CENTER: Main Content -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="30">
            <padding>
                <Insets top="40" left="40" right="40" bottom="40"/>
            </padding>
            <Label text="Choose a Game" styleClass="section-title"/>
            <TilePane hgap="20" vgap="20" alignment="CENTER">
                <Button text="Connect 4" onAction="#onConnect4Click" prefWidth="200" prefHeight="80" styleClass="game-button"/>
                <Button text="Tic Tac Toe" prefWidth="200" prefHeight="80" styleClass="game-button"/>
                <Button text="Chess" prefWidth="200" prefHeight="80" styleClass="game-button"/>
            </TilePane>
        </VBox>
    </center>

    <!-- RIGHT SIDEBAR: Quick Match or Stats -->
    <right>
        <VBox spacing="15" alignment="TOP_CENTER" prefWidth="250" styleClass="sidebar">
            <padding>
                <Insets top="20" left="15" right="15" bottom="20"/>
            </padding>
            <Label text="Quick Match" styleClass="sidebar-title"/>
            <Button text="Find Opponent" fx:id="quickMatchButton" prefWidth="200" styleClass="play-button"/>
            <Separator/>
            <Label text="Recent Scores" styleClass="sidebar-title"/>
            <ListView fx:id="recentScores" styleClass="list-view"/>
        </VBox>
    </right>

</BorderPane>
