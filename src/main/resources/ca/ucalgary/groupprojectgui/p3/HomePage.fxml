<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.HomePageController"
           styleClass="home-background"
           prefWidth="1200" prefHeight="800">

    <!-- Main content container -->
    <HBox fx:id="mainContainer" spacing="40" style="-fx-padding: 30;">

        <!-- CENTER + RIGHT AREA -->
        <HBox spacing="20" fillHeight="true" HBox.hgrow="ALWAYS">
            <!-- CENTER: MAIN CONTENT AREA -->
            <BorderPane fx:id="homePane"
                        styleClass="main-glow-box"
                        prefWidth="1000"
                        HBox.hgrow="ALWAYS"
                        style="-fx-padding: 40; -fx-background-radius: 20;"
                        VBox.vgrow="ALWAYS">
                <!-- TOP: Search Field -->
                <top>
                    <HBox spacing="20" alignment="CENTER" styleClass="top-header">
                        <ImageView fx:id="img" fitHeight="90" preserveRatio="true" pickOnBounds="true"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <StackPane alignment="CENTER_RIGHT" maxWidth="400">
                            <TextField fx:id="gameSearchField"
                                       promptText="Search games..."
                                       styleClass="search-text-field"
                                       prefWidth="800"
                                       prefHeight="50"/>
                            <Label text="🔍" mouseTransparent="true"
                                   style="-fx-font-size: 16px; -fx-text-fill: #bbbbbb; -fx-padding: 0 12 0 0;"/>
                        </StackPane>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ImageView fx:id="profileIcon" fitHeight="45" fitWidth="45" pickOnBounds="true" onMouseClicked="#openManageProfile"/>
                    </HBox>
                </top>

                <!-- CENTER: Game UI -->
                <center>
                    <VBox alignment="TOP_CENTER" spacing="30" style="-fx-padding: 30;">
                        <Label text="CHOOSE A GAME" styleClass="section-title"/>
                        <HBox fx:id="gameTilePane" alignment="CENTER" spacing="40">
                            <!-- TIC TAC TOE CARD -->
                            <VBox alignment="TOP_CENTER" spacing="15" styleClass="game-card">
                                <Label text="Tic Tac Toe" styleClass="game-title"/>
                                <ImageView fx:id="tttImage" fitWidth="220" fitHeight="130" preserveRatio="true" styleClass="game-preview"/>
                                <Label text="Battle in a grid of 3x3. Outsmart your opponent in a retro showdown!"
                                       wrapText="true" maxWidth="250" styleClass="game-description"/>
                                <Button fx:id="tttBtn" text="PLAY NOW" onAction="#onTicTacToeClick" styleClass="play-now-button"/>
                            </VBox>
                            <!-- CONNECT 4 CARD -->
                            <VBox alignment="TOP_CENTER" spacing="15" styleClass="game-card">
                                <Label text="Connect 4" styleClass="game-title"/>
                                <ImageView fx:id="connect4Image" fitWidth="220" fitHeight="130" preserveRatio="true" styleClass="game-preview"/>
                                <Label text="Classic vertical strategy game with a neon twist. Connect four of your pieces to win!"
                                       wrapText="true" maxWidth="250" styleClass="game-description"/>
                                <Button fx:id="connect4Btn" text="PLAY NOW" onAction="#onConnect4Click" styleClass="play-now-button"/>
                            </VBox>
                            <!-- CHECKERS CARD -->
                            <VBox alignment="TOP_CENTER" spacing="15" styleClass="game-card">
                                <Label text="Checkers" styleClass="game-title"/>
                                <ImageView fx:id="checkersImage" fitWidth="220" fitHeight="130" preserveRatio="true" styleClass="game-preview"/>
                                <Label text="Jump your way to victory in this classic game with a neon twist."
                                       wrapText="true" maxWidth="250" styleClass="game-description"/>
                                <Button fx:id="checkersBtn" text="PLAY NOW" onAction="#onCheckersClick" styleClass="play-now-button"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </center>
                <bottom>
                    <!-- LEFT: SIDEBAR PANEL -->
                    <HBox fx:id="sidebar"
                          alignment="TOP_CENTER"
                          spacing="20"
                          prefWidth="100"
                          styleClass="neon-sidebar"
                          style="-fx-background-radius: 20; -fx-padding: 25;"
                          HBox.Hgrow="ALWAYS">
                        <Button fx:id="leaderboardBtn" text="🏆 LEADER BOARD" onAction="#onLeaderboardClick" styleClass="neon-icon-button" prefWidth="200" prefHeight="35"/>
                        <Button fx:id="logoutButton" text="⎋ LOG OUT" onAction="#handleLogout" styleClass="neon-icon-button" prefWidth="200" prefHeight="35"/>
                    </HBox>
                </bottom>
            </BorderPane>

            <!-- RIGHT: FRIENDS PANEL -->
            <VBox fx:id="friendsPanel" spacing="20" styleClass="right-sidebar" prefWidth="300">
                <!-- Header -->
                <HBox alignment="CENTER_LEFT">
                    <Label text="Friends" styleClass="friends-header"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✖" styleClass="close-button"/>
                </HBox>

                <!-- Friend list container -->
                <VBox fx:id="playersContainer" styleClass="friends-list-container" VBox.vgrow="ALWAYS">

                </VBox>
            </VBox>

        </HBox>
    </HBox>

    <!-- POPUP CONTAINER (on top of everything) -->
    <StackPane fx:id="popupContainer"
               style="-fx-background-color: transparent;"
               visible="false"
               alignment="CENTER">
        <!-- Popups will be added here programmatically -->
    </StackPane>
</StackPane>

