<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox fx:id="mainContainer"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.HomePageController"
      styleClass="home-background"
      prefWidth="1200" prefHeight="800"
      spacing="40"
      style="-fx-padding: 30;">

    <!-- LEFT: SIDEBAR PANEL -->
    <VBox fx:id="sidebar"
          alignment="TOP_CENTER"
          spacing="20"
          prefWidth="100"
          styleClass="neon-sidebar"
          style="-fx-background-radius: 20; -fx-padding: 25;">

        <ImageView fx:id="img" fitHeight="80" preserveRatio="true" pickOnBounds="true"/>
        <ImageView fx:id="heartIcon" fitHeight="28" fitWidth="28" pickOnBounds="true" onMouseClicked="#handleQuickMatch"/>
        <ImageView fx:id="bellIcon" fitHeight="28" fitWidth="28" pickOnBounds="true" onMouseClicked="#openNotificationPanel"/>
        <ImageView fx:id="friendsIcon" fitHeight="28" fitWidth="28" pickOnBounds="true" onMouseClicked="#openFriendRequests"/>
        <ImageView fx:id="profileIcon" fitHeight="28" fitWidth="28" pickOnBounds="true" onMouseClicked="#openManageProfile"/>
        <Button fx:id="leaderboardBtn" text="🏆" onAction="#onLeaderboardClick" styleClass="neon-icon-button" prefWidth="50" prefHeight="35"/>
        <Button fx:id="logoutButton" text="⎋" onAction="#handleLogout" styleClass="neon-icon-button" prefWidth="50" prefHeight="35"/>
    </VBox>

    <!-- CENTER + RIGHT AREA -->
    <HBox spacing="20">

        <!-- MAIN CONTENT AREA -->
        <BorderPane fx:id="homePane"
                    styleClass="main-glow-box"
                    prefWidth="1000"
                    style="-fx-padding: 40; -fx-background-radius: 20;">

            <!-- TOP: Search Field -->
            <top>
                <HBox spacing="20" alignment="CENTER" styleClass="top-header">
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane alignment="CENTER_RIGHT" maxWidth="400">
                        <TextField fx:id="gameSearchField"
                                   promptText="Search games..."
                                   styleClass="search-text-field"
                                   prefWidth="800"
                                   prefHeight="50"/>
                        <Label text="🔍" mouseTransparent="true"
                               style="-fx-font-size: 16px; -fx-text-fill: #bbbbbb; -fx-padding: 0 12 0 0;" />
                    </StackPane>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
            </top>

            <!-- CENTER: Game UI -->
            <center>
                <VBox alignment="TOP_CENTER" spacing="30" style="-fx-padding: 50;">
                    <Label text="Choose a Game" styleClass="section-title"/>
                    <HBox fx:id="gameTilePane" alignment="CENTER" spacing="30">
                        <Button fx:id="connect4Btn" text="Connect 4" styleClass="game-button" onAction="#onConnect4Click"/>
                        <Button fx:id="tttBtn" text="Tic Tac Toe" styleClass="game-button" onAction="#onTicTacToeClick"/>
                        <Button fx:id="checkersBtn" text="Checkers" styleClass="game-button" onAction="#onCheckersClick"/>

                    </HBox>
                    <ImageView fx:id="previewImage"
                               fitWidth="300"
                               fitHeight="200"
                               preserveRatio="true"
                               visible="false"
                               style="-fx-effect: dropshadow(gaussian, #ff00ff, 10, 0.5, 0, 0);"/>
                </VBox>
            </center>

            <!-- BOTTOM: Rocket + UFO -->

        </BorderPane>

        <!-- RIGHT: POPUP PANEL STACK -->
        <!-- RIGHT: POPUP PANEL STACK with animated elements -->
        <VBox fx:id="rightPanel"
              prefWidth="350"
              spacing="20"
              alignment="CENTER"
              style="-fx-padding: 20;">

            <!-- TOP: Floating UFO -->
            <ImageView fx:id="UFOImage"
                       fitHeight="100"
                       preserveRatio="true"
                       styleClass="glow-UFO"/>

            <!-- MIDDLE: Popup container where panels load -->
            <StackPane fx:id="popupContainer"
                       prefHeight="400"
                       alignment="CENTER_RIGHT"
                       maxWidth="350"
                       style="-fx-background-color: transparent;">
                <!-- Popups will be loaded here dynamically -->
            </StackPane>

            <!-- BOTTOM: Floating Rocket -->
            <ImageView fx:id="rocketImage"
                       fitHeight="120"
                       preserveRatio="true"
                       styleClass="glow-rocket"/>
        </VBox>


    </HBox>

</HBox>

