<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="root" stylesheets="@styles/login.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.ChangePasswordController">

    <children>
        <!-- Background Layers -->
        <Pane fx:id="gridBackground"
              AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0" />
        <Pane fx:id="animatedNeonLines"
              AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0" />
        <Pane fx:id="cyberGlow" layoutY="49.0" prefHeight="504.0" prefWidth="459.0"
              AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0" />

        <!-- Main Container (centered) -->
        <VBox fx:id="forgotContainer" alignment="CENTER" spacing="10"
              AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0">
            <children>
                <!-- Forgot Box (compact dimensions) -->
                <AnchorPane fx:id="forgotBox" maxWidth="350" styleClass="login-box">
                    <children>
                        <!-- StackPane for form switching -->
                        <StackPane fx:id="formsStack">
                            <children>
                                <!-- Forgot Password Form -->
                                <VBox fx:id="forgotForm" alignment="CENTER" spacing="12" styleClass="form" visible="true">
                                    <children>
                                        <!-- Header -->
                                        <VBox alignment="CENTER" spacing="5" styleClass="form-header">
                                            <children>
                                                <Label styleClass="form-title" text="FORGOT PASSWORD" />
                                                <Label styleClass="form-subtitle" text="Change your OMG Password" />
                                            </children>
                                        </VBox>

                                        <!-- Error Message for Forgot Password -->
                                        <Label fx:id="forgotErrorLabel" text=""
                                               visible="false" managed="false"
                                               styleClass="error-message"/>

                                        <!-- Email Verification Section -->
                                        <VBox fx:id="verifyEmailSection" spacing="5" styleClass="form-group">
                                            <children>
                                                <Label styleClass="form-label" text="Registered Email" />
                                                <TextField fx:id="forgotEmail" promptText="Enter your email" />
                                            </children>
                                        </VBox>

                                        <Button fx:id="verifyEmailBtn" onAction="#proceedForgot" styleClass="btn" text="VERIFY EMAIL" />

                                        <!-- Reset Password Section (initially hidden; displayed once the email is verified) -->
                                        <Label fx:id="resetErrorLabel" text=""
                                               visible="false" managed="false"
                                               styleClass="error-message"/>
                                        <VBox fx:id="resetPasswordSection" spacing="5" visible="false">
                                            <children>
                                                <VBox spacing="5" styleClass="form-group">
                                                    <children>
                                                        <Label styleClass="form-label" text="Old Password" />
                                                        <PasswordField fx:id="oldPassword" promptText="Enter your old password" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="5" styleClass="form-group">
                                                    <children>
                                                        <Label styleClass="form-label" text="New Password" />
                                                        <PasswordField fx:id="newPassword" promptText="Enter new password" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="5" styleClass="form-group" style="-fx-padding: 0 0 30 0 " >
                                                    <children>
                                                        <Label styleClass="form-label" text="Confirm New Password" />
                                                        <PasswordField fx:id="confirmNewPassword" promptText="Confirm new password" />
                                                    </children>
                                                </VBox>
                                                <Button fx:id="resetBtn" onAction="#resetPassword" prefWidth="450" styleClass="btn" text="RESET PASSWORD" />
                                            </children>
                                        </VBox>


                                        <!-- Navigation back to Manage Profile -->
                                        <HBox alignment="CENTER" styleClass="action-links">
                                            <children>
                                                <Hyperlink styleClass="link" onAction="#handleBack" text="Back to Manage Profile" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                    </children>
                </AnchorPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
