<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Pos?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.ChangePasswordController"
           prefWidth="1200" prefHeight="800"
           stylesheets="@styles/change_password.css"
           styleClass="root">

    <!-- Main Vertical Flow -->
    <VBox spacing="20" alignment="CENTER">

        <!-- Title -->
        <Label text="Change Password" styleClass="section-title"/>

        <!-- Step 1: Email or ID -->
        <TextField fx:id="emailOrIDField" promptText="Enter Email or Player ID" styleClass="form-field"/>
        <Button text="Verify" onAction="#handleVerify" styleClass="primary-button"/>


        <!-- Step 2: Password Reset -->
        <PasswordField fx:id="newPasswordField"
                       promptText="New Password"
                       visible="false" managed="false"
                       styleClass="form-field"/>

        <PasswordField fx:id="confirmPasswordField"
                       promptText="Confirm Password"
                       visible="false" managed="false"
                       styleClass="form-field"/>

        <Button fx:id="saveChangesButton"
                text="Save Changes"
                onAction="#handleSaveChanges"
                visible="false" managed="false"
                styleClass="primary-button"/>

    </VBox>

    <!-- Back Button -->
    <AnchorPane pickOnBounds="false">
        <Button text="← Back"
                onAction="#handleBack"
                styleClass="neon-outline-button"
                prefWidth="120" prefHeight="40"
                AnchorPane.leftAnchor="30.0"
                AnchorPane.bottomAnchor="30.0"/>
    </AnchorPane>

</StackPane>
