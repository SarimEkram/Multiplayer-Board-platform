<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<AnchorPane fx:id="root" stylesheets="@styles/login.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.LoginController">
    <children>
        <!-- Background Layers -->
        <Pane fx:id="gridBackground" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" />
        <Pane fx:id="animatedNeonLines" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" />
        <Pane fx:id="cyberGlow" layoutY="49.0" prefHeight="504.0" prefWidth="459.0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" />

        <!-- Main Container (centered) -->
        <VBox fx:id="loginContainer" alignment="CENTER" spacing="10" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <children>
                <!-- Login Box (compact dimensions) -->
                <AnchorPane fx:id="loginBox" maxWidth="350" styleClass="login-box">
                    <children>
                        <!-- StackPane for form switching -->
                        <StackPane fx:id="formsStack" >
                            <children>
                                <!-- Login Form -->
                                <VBox fx:id="loginForm" alignment="CENTER" minWidth="-Infinity" prefWidth="459.0" spacing="20.0" styleClass="form" visible="true">
                                    <children>
                                        <!-- Header -->
                                        <VBox alignment="CENTER" spacing="5.0" styleClass="form-header">
                                            <children>
                                                <Label styleClass="form-title" text="OMG LOGIN" />
                                                <Label styleClass="form-subtitle" text="Enter the OMG realm" />
                                            </children>
                                        </VBox>
                                        <!-- Username Field -->
                                        <VBox prefWidth="500" spacing="5" styleClass="form-group">
                                            <children>
                                                <Label styleClass="form-label" text="Username" />
                                                <TextField fx:id="loginUsername" prefHeight="30.0" prefWidth="300.0" promptText="Enter your username" />
                                            </children>
                                        </VBox>
                                        <!-- Password Field -->
                                        <VBox spacing="5" styleClass="form-group">
                                            <children>
                                                <Label styleClass="form-label" text="Password" />
                                                <PasswordField fx:id="loginPassword" promptText="Enter your password" />
                                            </children>
                                        </VBox>
                                        <!--  Forgot -->
                                        <HBox alignment="CENTER" spacing="15" styleClass="remember-forgot">
                                            <children>
                                                <!-- Spacer to push content to the right -->
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Hyperlink onAction="#showForgotForm" styleClass="forgot-link"   text="Forgot password?" textAlignment="RIGHT"/>
                                            </children>
                                        </HBox>

                                        <!-- Login Button -->
                                        <Button fx:id="loginButton" minHeight="-Infinity" minWidth="-Infinity" onAction="#handleLogin" prefHeight="46.0" prefWidth="339.0" styleClass="btn" text="LOGIN" />
                                        <!-- Register Link -->
                                        <HBox alignment="CENTER" styleClass="action-links">
                                            <children>
                                                <Text styleClass="account-prompt">Don't Have an Account? </Text>
                                                <Hyperlink onAction="#showRegisterForm" style="-fx-text-fill: #f0fff" styleClass="link " text=" Register" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Forgot Password Form -->
                                <VBox fx:id="forgotForm" alignment="CENTER" spacing="12" styleClass="form" visible="false">
                                    <children>
                                        <VBox alignment="CENTER" spacing="5" styleClass="form-header">
                                            <children>
                                                <Label styleClass="form-title" text="FORGOT PASSWORD" />
                                                <Label styleClass="form-subtitle" text="Reset your OMG access" />
                                            </children>
                                        </VBox>
                                        <!-- Email Verification Section -->
                                        <VBox fx:id="verifyEmailSection" spacing="5" styleClass="form-group">
                                            <children>
                                                <Label styleClass="form-label" text="Registered Email" />
                                                <TextField fx:id="forgotEmail" promptText="Enter your email" />
                                            </children>
                                        </VBox>
                                        <Button  fx:id="verifyEmailBtn" onAction="#proceedForgot" styleClass="btn" text="VERIFY EMAIL" />
                                        <!-- Reset Password Section (initially hidden) -->
                                        <VBox fx:id="resetPasswordSection" spacing="5" visible="false">
                                            <children>
                                                <VBox spacing="5" styleClass="form-group">
                                                    <children>
                                                        <Label styleClass="form-label" text="Reset Token" />
                                                        <TextField fx:id="resetToken" promptText="Enter reset token" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="5" styleClass="form-group">
                                                    <children>
                                                        <Label styleClass="form-label" text="New Password" />
                                                        <PasswordField fx:id="newPassword" promptText="Enter new password" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="5"  style="-fx-padding: 0 0 30 0" styleClass="form-group">
                                                    <children>
                                                        <Label styleClass="form-label" text="Confirm New Password" />
                                                        <PasswordField fx:id="confirmNewPassword"   promptText="Confirm new password" />
                                                    </children>
                                                </VBox>
                                                <Button onAction="#resetPassword" fx:id="resetBtn" styleClass="btn"  prefWidth="450" text="RESET PASSWORD" />
                                            </children>
                                        </VBox>
                                        <HBox alignment="CENTER" styleClass="action-links">
                                            <children>
                                                <Hyperlink onAction="#showLoginForm" styleClass="link" text="Back to Login" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Register Form -->
                                <VBox fx:id="registerForm" alignment="CENTER" spacing="12" styleClass="form" visible="false">
                                    <children>
                                        <VBox alignment="CENTER" spacing="5" styleClass="form-header">
                                            <children>
                                                <Label styleClass="form-title" text="OMG REGISTER" />
                                                <Label styleClass="form-subtitle" text="Join the OMG uprising" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5" styleClass="form-group">
                                            <children>
                                                <Label styleClass="form-label" text="Full Name" />
                                                <TextField fx:id="registerFullName" promptText="Enter your full name" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5" styleClass="form-group">
                                            <children>
                                                <Label styleClass="form-label" text="Username" />
                                                <TextField fx:id="registerUsername" promptText="Choose a username" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5" styleClass="form-group">
                                            <children>
                                                <Label styleClass="form-label" text="Email" />
                                                <TextField fx:id="registerEmail" promptText="Enter your email" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5" styleClass="form-group">
                                            <children>
                                                <Label styleClass="form-label" text="Password" />
                                                <PasswordField fx:id="registerPassword" promptText="Create a password" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5" styleClass="form-group">
                                            <children>
                                                <Label styleClass="form-label" text="Confirm Password" />
                                                <PasswordField fx:id="registerConfirmPassword" promptText="Confirm your password" />
                                            </children>
                                        </VBox>
                                        <Button onAction="#handleRegister" fx:id="registerBtn" styleClass="btn" text="REGISTER" />
                                        <HBox alignment="CENTER" styleClass="action-links">
                                            <children>
                                                <Hyperlink onAction="#showLoginForm" styleClass="link" text="Back to Login" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                    </children>
                </AnchorPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
