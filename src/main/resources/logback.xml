<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
      Scoped per FR-012: structured logging for connection failures, slow queries, and migration
      errors from the persistence layer only. Not a project-wide logging setup.
    -->
    <logger name="MatchmakingLeaderboard.persistence" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
