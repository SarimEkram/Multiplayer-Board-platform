<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="480.0" styleClass="blue-panel"  xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.groupprojectgui.p3.controllers.UserRegistrationController">
    <children>
        <Label text="Sign Up" styleClass="section-title">
            <VBox.margin>
                <Insets left="20.0" top="20.0" />
            </VBox.margin>
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <Label fx:id="registerErrorMessageLabel" styleClass="label-error"
               alignment="CENTER"
               maxWidth="Infinity">
            <VBox.margin>
                <Insets left="15.0" />
            </VBox.margin>
        </Label>
        <TextField fx:id="email" promptText="Email" styleClass="hf">
            <VBox.margin>
                <Insets left="15.0" right="15.0" top="15.0" />
            </VBox.margin>
        </TextField>
        <TextField fx:id="username" promptText="Username" styleClass="hf">
            <VBox.margin>
                <Insets left="15.0" right="15.0" top="15.0" />
            </VBox.margin>
        </TextField>
        <PasswordField fx:id="password" prefHeight="26.0" prefWidth="424.0" promptText="Password" styleClass="hf">
            <VBox.margin>
                <Insets left="15.0" right="15.0" top="15.0" />
            </VBox.margin>
        </PasswordField>
        <Button mnemonicParsing="false" onAction="#handleRegister" prefHeight="38.0" prefWidth="451.0" styleClass="blue-btn" text="Register" textFill="#fff9f9">
            <font>
                <Font size="17.0" />
            </font>
            <VBox.margin>
                <Insets left="15.0" right="15.0" top="20.0" />
            </VBox.margin>
        </Button>
        <Button fx:id="loginButton" mnemonicParsing="false" onAction="#switchToLogin" styleClass="link-btn" text="Already have an account? Log in">
            <VBox.margin>
                <Insets left="15.0" right="15.0" top="25.0" />
            </VBox.margin>
        </Button>
    </children>
</VBox>
